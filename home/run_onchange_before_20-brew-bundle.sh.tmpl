#!/usr/bin/env bash
set -euo pipefail

brew_mode={{ env "DOTFILES_BREW_MODE" | default "upgrade" | quote }}
case "$brew_mode" in
  upgrade)
    brew_bundle_args=(--file=-)
    ;;
  install)
    brew_bundle_args=(--no-upgrade --file=-)
    ;;
  skip)
    echo "==> Skipping brew bundle"
    exit 0
    ;;
  *)
    echo "DOTFILES_BREW_MODE must be upgrade, install, or skip (got: $brew_mode)" >&2
    exit 2
    ;;
esac

if ! command -v brew >/dev/null 2>&1; then
{{ if eq .chezmoi.os "darwin" -}}
  eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else -}}
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}
fi

echo "==> Running brew bundle ($brew_mode mode)"
brew bundle "${brew_bundle_args[@]}" <<'BREWFILE_EOF'
{{ range .packages.common.brews -}}
brew {{ . | quote }}
{{ end }}
{{- if ne .chezmoi.os "darwin" -}}
{{   range .packages.linux.brews }}
brew {{ . | quote }}
{{-  end }}
{{   range .packages.linux.casks }}
cask {{ . | quote }}
{{-  end }}
{{-  if .installCodex -}}
{{   range .packages.linux.codex_casks }}
cask {{ . | quote }}
{{-  end }}
{{-  end }}
{{- end -}}
{{- if eq .chezmoi.os "darwin" -}}
{{   range .packages.darwin.base.brews }}
brew {{ . | quote }}
{{-  end }}
{{   range .packages.darwin.base.casks }}
cask {{ . | quote }}
{{-  end }}
{{     range .packages.darwin.desktop.brews }}
brew {{ . | quote }}
{{-    end }}
{{     range .packages.darwin.desktop.casks }}
cask {{ . | quote }}
{{-    end }}
{{     range .packages.darwin.desktop.mas }}
mas {{ .name | quote }}, id: {{ .id }}
{{-    end }}
{{-  if .includeSocials -}}
{{     range .packages.darwin.socials.mas }}
mas {{ .name | quote }}, id: {{ .id }}
{{-    end }}
{{-  end }}
{{-  if .includeWorkApps -}}
{{     range .packages.darwin.work.casks }}
cask {{ . | quote }}
{{-    end }}
{{     range .packages.darwin.work.mas }}
mas {{ .name | quote }}, id: {{ .id }}
{{-    end }}
{{-  end }}
{{- end }}
BREWFILE_EOF
