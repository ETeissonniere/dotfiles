#!/usr/bin/env bash
# Runs after every `chezmoi apply`. Prints a short TODO list of post-install
# steps that still need manual attention. Silent when everything's set.
set -euo pipefail

pending=()

{{ if eq .chezmoi.os "darwin" -}}
xcode_developer_dir="/Applications/Xcode.app/Contents/Developer"

if ! xcrun --find clang >/dev/null 2>&1; then
  pending+=("Install the Xcode Command Line Tools: xcode-select --install")
fi

if [[ ! -d "$xcode_developer_dir" ]]; then
  pending+=("Install Xcode from the App Store, then re-run chezmoi apply")
elif [[ "$(xcode-select --print-path 2>/dev/null || true)" != "$xcode_developer_dir" ]]; then
  pending+=("Select and finish Xcode setup: sudo xcode-select --switch $xcode_developer_dir && sudo xcodebuild -runFirstLaunch")
elif ! xcodebuild -checkFirstLaunchStatus >/dev/null 2>&1; then
  pending+=("Finish Xcode setup: sudo xcodebuild -runFirstLaunch")
fi
{{- end }}

{{ if .setupGit -}}
if [[ -f "$HOME/.ssh/id_ed25519.pub" ]] && command -v gh >/dev/null 2>&1; then
  # Compare by base64 data (field 2) since GitHub strips the comment on upload.
  pub_key_data="$(awk '{print $2}' "$HOME/.ssh/id_ed25519.pub")"

  if ! gh auth status >/dev/null 2>&1; then
    pending+=("Register SSH key on GitHub (will also run gh auth login): {{ .chezmoi.workingTree }}/scripts/post/setup_github.sh")
  elif ! gh api user/keys --jq '.[].key | split(" ")[1]' 2>/dev/null \
         | grep -qFx "$pub_key_data"; then
    pending+=("Register SSH key on GitHub: {{ .chezmoi.workingTree }}/scripts/post/setup_github.sh")
  fi
fi
{{- end }}

{{ if .useGitea -}}
if command -v tea >/dev/null 2>&1 && [[ ! -f "$HOME/.config/tea/config.yml" ]]; then
  pending+=("Set up Gitea (tea login + SSH key): {{ .chezmoi.workingTree }}/scripts/post/setup_gitea.sh")
fi
{{- end }}

if [[ ${#pending[@]} -gt 0 ]]; then
  echo
  echo "==> Post-install steps pending:"
  printf '    - %s\n' "${pending[@]}"
  echo
fi
